# Copy and rename this file to .env — never commit .env to Git
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional comma-separated browser origins allowed to call the API.
# Vercel automatically allows https://$VERCEL_URL.
ALLOWED_ORIGINS=https://your-production-domain.example
